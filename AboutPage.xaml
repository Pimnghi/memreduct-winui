<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="memreduct_winui.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto"
        Padding="24,16,24,0">
        <Grid HorizontalAlignment="Stretch">
            <StackPanel
                MaxWidth="1000"
                Margin="0,0,0,32"
                HorizontalAlignment="Stretch"
                Spacing="28">

                <!-- App identity -->
                <StackPanel
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Spacing="12">
                    <Image
                        Width="96"
                        Height="96"
                        Source="Assets/AppIcon.ico"
                        Stretch="Uniform" />
                    <TextBlock
                        x:Name="AppNameText"
                        HorizontalAlignment="Center"
                        Text="Mem Reduct WinUI"
                        Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>

                <!-- Application and project information -->
                <StackPanel Spacing="4">
                    <toolkit:SettingsCard Header="Version">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBlock
                            x:Name="VersionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontWeight="SemiBold"
                            Text="3.5.3" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Header="About">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.Description>
                            <TextBlock
                                LineHeight="22"
                                TextWrapping="Wrap">
                                Lightweight real-time memory management application.<LineBreak />
                                Uses undocumented internal system features (Native API) to clear system cache.<LineBreak />
                                Compatible with Windows 10/11 64-bit and ARM64.
                            </TextBlock>
                        </toolkit:SettingsCard.Description>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Header="Author">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBlock
                            x:Name="AuthorText"
                            Text="Pimnghi"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Header="Copyright">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8C8;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBlock
                            x:Name="CopyrightText"
                            Text="© 2024-2026 Pimnghi"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Header="Upstream project">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8CE;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBlock
                            x:Name="BasedOnText"
                            Text="Mem Reduct by Henry++"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        Header="github.com/pimnghi/memreduct-winui"
                        ActionIconToolTip="Open project repository"
                        Click="OnWebsiteClick"
                        IsActionIconVisible="True"
                        IsClickEnabled="True">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE71B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                    </toolkit:SettingsCard>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
