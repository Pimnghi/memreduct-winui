<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="memreduct_winui.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryRightColumn.Width" Value="0" />
                        <Setter Target="PageFileCard.(Grid.Column)" Value="0" />
                        <Setter Target="CacheCard.(Grid.Column)" Value="0" />
                        <Setter Target="CacheCard.(Grid.Row)" Value="1" />
                        <Setter Target="SecondaryCardsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="SecondaryCardsGrid.RowSpacing" Value="12" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SecondaryRightColumn.Width" Value="*" />
                        <Setter Target="PageFileCard.(Grid.Column)" Value="0" />
                        <Setter Target="CacheCard.(Grid.Column)" Value="1" />
                        <Setter Target="CacheCard.(Grid.Row)" Value="0" />
                        <Setter Target="SecondaryCardsGrid.ColumnSpacing" Value="12" />
                        <Setter Target="SecondaryCardsGrid.RowSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Auto"
            Padding="24,16,24,104">
            <Grid HorizontalAlignment="Stretch">
                <StackPanel
                    MaxWidth="1000"
                    HorizontalAlignment="Stretch"
                    Spacing="16">

                    <InfoBar
                        x:Name="ResultBar"
                        IsClosable="True"
                        IsOpen="False" />

                    <!-- Physical memory hero card -->
                    <Border
                        x:Name="PhysicalCard"
                        Padding="24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="20">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon
                                        Width="40"
                                        Height="40"
                                        Glyph="&#xE950;"
                                        FontSize="26"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        x:Name="PhysicalTitle"
                                        Text="Physical memory"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock
                                        x:Name="PhysicalPctLabel"
                                        HorizontalAlignment="Right"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="13"
                                        Text="Usage" />
                                    <TextBlock
                                        x:Name="PhysicalPctText"
                                        HorizontalAlignment="Right"
                                        FontSize="46"
                                        FontWeight="SemiBold"
                                        LineHeight="52"
                                        Text="0%" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar
                                x:Name="PhysicalBar"
                                Height="10"
                                Minimum="0"
                                Maximum="100" />

                            <Grid
                                x:Name="PhysicalFooter"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="24">
                                <StackPanel>
                                    <TextBlock
                                        x:Name="PhysicalFreeLabel"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        Text="Available" />
                                    <TextBlock
                                        x:Name="PhysicalFreeText"
                                        Margin="0,3,0,0"
                                        FontSize="16"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        x:Name="PhysicalTotalLabel"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="12"
                                        Text="Total" />
                                    <TextBlock
                                        x:Name="PhysicalTotalText"
                                        Margin="0,3,0,0"
                                        FontSize="16"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Secondary memory cards -->
                    <Grid
                        x:Name="SecondaryCardsGrid"
                        ColumnSpacing="12"
                        RowSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SecondaryRightColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="PageFileCard"
                            Grid.Column="0"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <SymbolIcon
                                            Width="36"
                                            Height="36"
                                            Symbol="MapDrive"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="PageFileTitle"
                                            Text="Pagefile"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock
                                            x:Name="PageFilePctLabel"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="Usage" />
                                        <TextBlock
                                            x:Name="PageFilePctText"
                                            HorizontalAlignment="Right"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            Text="0%" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar
                                    x:Name="PageFileBar"
                                    Height="8"
                                    Minimum="0"
                                    Maximum="100" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="PageFileFreeLabel"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="Available" />
                                        <TextBlock
                                            x:Name="PageFileFreeText"
                                            Margin="0,3,0,0"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            x:Name="PageFileTotalLabel"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="Total" />
                                        <TextBlock
                                            x:Name="PageFileTotalText"
                                            Margin="0,3,0,0"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="CacheCard"
                            Grid.Column="1"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <SymbolIcon
                                            Width="36"
                                            Height="36"
                                            Symbol="AllApps"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="CacheTitle"
                                            Text="System working set"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock
                                            x:Name="CachePctLabel"
                                            HorizontalAlignment="Right"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="Usage" />
                                        <TextBlock
                                            x:Name="CachePctText"
                                            HorizontalAlignment="Right"
                                            FontSize="28"
                                            FontWeight="SemiBold"
                                            Text="0%" />
                                    </StackPanel>
                                </Grid>

                                <ProgressBar
                                    x:Name="CacheBar"
                                    Height="8"
                                    Minimum="0"
                                    Maximum="100" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="CacheFreeLabel"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="Available" />
                                        <TextBlock
                                            x:Name="CacheFreeText"
                                            Margin="0,3,0,0"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            x:Name="CacheTotalLabel"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            FontSize="12"
                                            Text="Total" />
                                        <TextBlock
                                            x:Name="CacheTotalText"
                                            Margin="0,3,0,0"
                                            FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid
            MaxWidth="1000"
            Margin="24,0,24,24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom">
            <Button
                x:Name="CleanBtn"
                MinWidth="170"
                Padding="18,10"
                HorizontalAlignment="Right"
                Click="OnCleanClick"
                Style="{StaticResource AccentButtonStyle}">
                <Grid>
                    <StackPanel
                        x:Name="CleanButtonIdleContent"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock
                            x:Name="CleanButtonText"
                            Text="Clean memory" />
                    </StackPanel>
                    <StackPanel
                        x:Name="CleanButtonBusyContent"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="Collapsed">
                        <ProgressRing
                            x:Name="CleanProgressRing"
                            Width="18"
                            Height="18"
                            IsActive="False" />
                        <TextBlock
                            x:Name="CleaningButtonText"
                            Text="Clean memory…" />
                    </StackPanel>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</Page>
