<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MemReduct.WinUI.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto"
        Padding="24,0,24,0">
        <Grid HorizontalAlignment="Stretch">
            <StackPanel
                MaxWidth="1000"
                Margin="0,16,0,32"
                HorizontalAlignment="Stretch"
                Spacing="28">

                <!-- App identity -->
                <StackPanel
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Spacing="12">
                    <Image
                        Width="96"
                        Height="96"
                        Source="ms-appx:///Assets/AppIcon.ico"
                        Stretch="Uniform" />
                    <TextBlock
                        x:Name="AppNameText"
                        HorizontalAlignment="Center"
                        Text="Mem Reduct WinUI"
                        Style="{StaticResource TitleTextBlockStyle}" />
                </StackPanel>

                <!-- Application and project information -->
                <StackPanel Spacing="4">
                    <toolkit:SettingsCard
                        x:Name="AboutCard"
                        Header="About"
                        ContentAlignment="Vertical">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE946;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.Description>
                            <TextBlock
                                x:Name="AboutDescriptionText"
                                LineHeight="22"
                                Text="A lightweight real-time memory management application that uses the Windows Native API to clear system caches. Compatible with Windows 10/11 x64 and ARM64."
                                TextWrapping="Wrap" />
                        </toolkit:SettingsCard.Description>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="VersionCard"
                        Header="Version">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8EC;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBlock
                            x:Name="VersionText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontWeight="SemiBold" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="AuthorCard"
                        Header="Author"
                        ActionIconToolTip="https://github.com/Pimnghi"
                        Click="OnAuthorClick"
                        IsActionIconVisible="True"
                        IsClickEnabled="True">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                        <TextBlock
                            x:Name="AuthorText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontWeight="SemiBold"
                            Text="Pimnghi"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="UpstreamCard"
                        Header="Upstream project"
                        ActionIconToolTip="https://github.com/henrypp/memreduct"
                        Click="OnUpstreamClick"
                        IsActionIconVisible="True"
                        IsClickEnabled="True">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8CE;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                        <TextBlock
                            x:Name="BasedOnText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontWeight="SemiBold"
                            Text="Mem Reduct"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard
                        x:Name="ProjectLinkCard"
                        Header="Project repository"
                        ActionIconToolTip="https://github.com/Pimnghi/memreduct-winui"
                        Click="OnProjectRepositoryClick"
                        IsActionIconVisible="True"
                        IsClickEnabled="True">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE71B;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <toolkit:SettingsCard.ActionIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </toolkit:SettingsCard.ActionIcon>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontWeight="SemiBold"
                            Text="Mem Reduct WinUI"
                            TextWrapping="Wrap" />
                    </toolkit:SettingsCard>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
