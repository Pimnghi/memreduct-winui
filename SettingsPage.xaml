<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="memreduct_winui.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <ScrollViewer HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
        <StackPanel Spacing="24" HorizontalAlignment="Stretch">

            <StackPanel Spacing="8">
                <TextBlock x:Name="GeneralHeader" Text="常规" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <StackPanel Spacing="6">
                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="LanguageLabel" Text="语言 (Language):" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" Width="180" SelectionChanged="OnLanguageChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="AlwaysOnTopLabel" Text="窗口始终置顶" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ToggleSwitch x:Name="ToggleAlwaysOnTop" Grid.Column="1" Toggled="OnToggleChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="LoadOnStartupLabel" Text="开机自动启动" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ToggleSwitch x:Name="ToggleLoadOnStartup" Grid.Column="1" Toggled="OnToggleChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="StartMinimizedLabel" Text="启动时最小化到系统托盘" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ToggleSwitch x:Name="ToggleStartMinimized" Grid.Column="1" Toggled="OnToggleChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ConfirmCleanLabel" Text="清理前弹窗确认" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ToggleSwitch x:Name="ToggleConfirmClean" Grid.Column="1" Toggled="OnToggleChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="AppearanceHeader" Text="外观" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <StackPanel Spacing="6">
                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ThemeLabel" Text="应用主题" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ComboBox x:Name="CmbTheme" Grid.Column="1" Width="180" SelectionChanged="OnThemeChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="NotificationHeader" Text="通知" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <StackPanel Spacing="6">
                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ShowResultsLabel" Text="清理完成后显示结果通知" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ToggleSwitch x:Name="ToggleShowResults" Grid.Column="1" Toggled="OnToggleChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="NotificationSoundLabel" Text="清理完成后播放提示音" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ToggleSwitch x:Name="ToggleNotificationSound" Grid.Column="1" Toggled="OnToggleChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="RegionsHeader" Text="内存清理区域" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <StackPanel Spacing="6">
                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="WorkingSetLabel" Text="工作集 (Working Set)" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <CheckBox x:Name="ChkWorkingSet" Grid.Column="1" Click="OnRegionChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="SystemFileCacheLabel" Text="系统文件缓存" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <CheckBox x:Name="ChkSystemFileCache" Grid.Column="1" Click="OnRegionChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="StandbyListLowPriorityLabel" Text="低优先级 Standby 列表" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <CheckBox x:Name="ChkStandbyPriority0" Grid.Column="1" Click="OnRegionChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="StandbyListLabel" Text="Standby 列表" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <CheckBox x:Name="ChkStandbyList" Grid.Column="1" Click="OnRegionChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ModifiedListLabel" Text="Modified 列表" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <CheckBox x:Name="ChkModifiedList" Grid.Column="1" Click="OnRegionChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="CombineMemoryListsLabel" Text="合并内存列表" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <CheckBox x:Name="ChkCombineMemoryLists" Grid.Column="1" Click="OnRegionChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="RegistryCacheLabel" Text="注册表缓存" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <CheckBox x:Name="ChkRegistryCache" Grid.Column="1" Click="OnRegionChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ModifiedFileCacheLabel" Text="修改的文件缓存" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <CheckBox x:Name="ChkModifiedFileCache" Grid.Column="1" Click="OnRegionChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="TrayHeader" Text="托盘图标" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <StackPanel Spacing="6">
                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="TrayLeftLabel" Text="双击左键动作:" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ComboBox x:Name="CmbTrayLeft" Grid.Column="1" Width="180" SelectionChanged="OnTrayActionChanged"/>
                        </Grid>
                    </Border>

                    <Border HorizontalAlignment="Stretch" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid Padding="16,12" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="TrayMidLabel" Text="单击中键动作:" VerticalAlignment="Center" Style="{StaticResource BodyTextBlockStyle}"/>
                            <ComboBox x:Name="CmbTrayMid" Grid.Column="1" Width="180" SelectionChanged="OnTrayActionChanged"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>