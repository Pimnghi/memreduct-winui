<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="memreduct_winui.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="400">
            <TextBlock x:Name="AppNameText" Text="Mem Reduct WinUI" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="VersionText" Text="Version 3.5.3" HorizontalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                Lightweight real-time memory management application.<LineBreak/>
                Uses undocumented internal system features (Native API) to clear system cache.<LineBreak/>
                Compatible with Windows 10/11 64-bit and ARM64.
            </TextBlock>

            <StackPanel Spacing="4" HorizontalAlignment="Center">
                <TextBlock x:Name="AuthorText" Text="Author: Pimnghi" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock x:Name="CopyrightText" Text="(c) 2024-2025 Pimnghi" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock x:Name="BasedOnText" Text="Based on Mem Reduct by Henry++" HorizontalAlignment="Center" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>

            <HyperlinkButton x:Name="WebsiteLink" Content="github.com/pimnghi/memreduct-winui" NavigateUri="https://github.com/pimnghi/memreduct-winui"
                             HorizontalAlignment="Center" FontSize="12"/>
        </StackPanel>
    </Grid>
</Page>
