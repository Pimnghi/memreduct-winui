<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="memreduct_winui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Mem Reduct"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleLabel" Text="Mem Reduct" Grid.Row="0" VerticalAlignment="Center" Margin="48,0,0,0"
                   FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>

        <controls:NavigationView x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            CompactModeThresholdWidth="0">

        <controls:NavigationView.MenuItems>
            <controls:NavigationViewItem Icon="Globe" Content="Memory" Tag="main"/>
            <controls:NavigationViewItem Icon="Setting" Content="Settings" Tag="settings"/>
        </controls:NavigationView.MenuItems>

        <controls:NavigationView.FooterMenuItems>
            <controls:NavigationViewItem Tag="about">
                <controls:NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" FontSize="16"/>
                </controls:NavigationViewItem.Icon>
            </controls:NavigationViewItem>
        </controls:NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </controls:NavigationView>
    </Grid>
</Window>
